# MongoDB (Production)
MONGO_URI=mongodb+srv://your_production_db_user:your_production_db_password@cluster.mongodb.net/blacklocustDB_prod?appName=Cluster0

# JWT Secret (Production Ready - 64+ characters, cryptographically secure)
JWT_SECRET=Ki6NUJ4AQtis8HKPrwhNxCo1NRBCBHVU1okelBYmgKz2kimzvh14L3KqntrG7xcV6tzKrNh7zTSAStHFo8A3TQ==

# Frontend URL (Production - Must match exactly, no trailing slash)
FRONTEND_URL=https://om-frontend-rsti.onrender.com

# Server Port (Production)
PORT=5002

# Node Environment (Production)
NODE_ENV=production

# Razorpay (Production - Replace with actual keys)
RAZORPAY_KEY_ID=your_production_razorpay_key_id
RAZORPAY_KEY_SECRET=your_production_razorpay_key_secret

# Stripe Payment (Production - Replace with actual keys)
STRIPE_SECRET_KEY=your_production_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=your_production_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=your_production_stripe_webhook_secret

# Email Service (Production - Replace with actual credentials)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_production_email@gmail.com
EMAIL_PASS=your_production_app_password
EMAIL_FROM=Black Locust <noreply@blacklocust.com>

# ImageKit Configuration (Production - Replace with actual keys)
IMAGEKIT_PUBLIC_KEY=your_production_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_production_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_production_endpoint
